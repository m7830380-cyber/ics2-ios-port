<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless co-op test bot: joins a real game (test copy started with -ics2test) over the real protocol,
       runs a scenario and prints RESULT: PASS / FAIL. Shares coop/common and LiteNetLib with the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);LITENETLIB_UNSAFE</DefineConstants>
    <NoWarn>$(NoWarn);1591;SYSLIB0050;SYSLIB0051</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\common\**\*.cs" Link="Common\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\third_party\LiteNetLib\**\*.cs" Link="LiteNetLib\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
